# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders. `android/` is NOT ignored: this project has
# hand-written native code (the Glance widget), which `expo prebuild` would
# regenerate away, so the Android project is committed.
/ios

# JVM crash logs from Gradle
hs_err_pid*.log
replay_pid*.log

# Python bytecode from scripts/
__pycache__/
*.pyc
